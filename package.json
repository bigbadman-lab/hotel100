{
  "name": "hotel100",
  "private": true,
  "version": "0.0.0",
  "description": "$HOTEL MVP monorepo — 100 rooms. No reservations.",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev:web": "pnpm --filter @hotel100/web dev",
    "dev:worker": "pnpm --filter @hotel100/worker dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:contracts": "cd contracts && forge test --use ../.solc/solc-0.8.28",
    "install:solc": "bash scripts/install-solc.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
