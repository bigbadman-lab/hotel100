# =============================================================================
# $HOTEL MVP — environment key names only (NO SECRETS)
# Copy to .env and fill locally. Never commit real values.
# Unresolved production inputs must remain configurable; do not invent them.
# =============================================================================

# --- Chain ---
HOTEL_CHAIN_ID=4663
HOTEL_RPC_URL=
HOTEL_LAUNCH_BLOCK=
HOTEL_OPEN_BLOCK=
HOTEL_OPEN_TIMESTAMP=

# --- Live activation (do not set true without Gate J PASS) ---
HOTEL_LIVE=false

# --- Brand / domain ---
HOTEL_DOMAIN=
HOTEL_BRAND_NAME=
NEXT_PUBLIC_HOTEL_DOMAIN=
NEXT_PUBLIC_HOTEL_LIVE=false

# --- Token metadata (unresolved until launch config freeze) ---
HOTEL_TOKEN_NAME=
HOTEL_TOKEN_SYMBOL=
HOTEL_TOKEN_ADDRESS=

# --- Pons V2 (do not invent production addresses) ---
PONS_V2_FACTORY_ADDRESS=
PONS_V2_ROUTER_ADDRESS=
PONS_FEE_ESCROW_ADDRESS=
PONS_LAUNCH_SALT=
PONS_CREATOR_TAX_BPS=300
PONS_BUYBACK_ENABLED=false
PONS_OPENING_BUY_ETH=0.06
PONS_OPENING_BUY_MAX_SLIPPAGE_BPS=100

# --- HoodLock (do not invent production addresses) ---
HOODLOCK_ADDRESS=
HOODLOCK_MIN_DURATION_SECONDS=604800
HOODLOCK_PRODUCTION_BUFFER_SECONDS=300

# --- RoomService ---
ROOMSERVICE_ADDRESS=
ROOMSERVICE_PONS_FEE_ESCROW=

# --- Production wallet roles (exactly three distinct EOAs; never invent) ---
HOTEL_DEPLOYER_OWNER_ADDRESS=
HOTEL_ENTITLEMENT_SIGNER_ADDRESS=
HOTEL_WORKER_WRITER_ADDRESS=

# --- Secrets: set only in local/runtime secret stores — never commit ---
# HOTEL_ENTITLEMENT_SIGNER_PRIVATE_KEY=
# HOTEL_WORKER_WRITER_PRIVATE_KEY=
# Note: deployer/owner private key must NOT be stored in backend infrastructure.

# --- Supabase / Postgres ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Worker / indexer ---
WORKER_POLL_INTERVAL_MS=60000
HOLDER_RECONCILE_INTERVAL_MS=300000
PUBLIC_STALE_THRESHOLD_MS=30000
ROOM_POLL_INTERVAL_MS=2000
LIVE_CONFIRMATIONS=1
FINANCIAL_CONFIRMATIONS=2
COLLECTION_CONFIRMATIONS=1
SERVICE_CATCHUP_MAX=8

# --- Entitlement API ---
ENTITLEMENT_CHALLENGE_TTL_SECONDS=300
ENTITLEMENT_SIGNATURE_VALIDITY_SECONDS=86400
ENTITLEMENT_RATE_LIMIT_PER_IP=
ENTITLEMENT_RATE_LIMIT_PER_WALLET=

# --- Exclusions (comma-separated lowercase addresses; unresolved until known) ---
HOTEL_MANUAL_EXCLUSIONS=
